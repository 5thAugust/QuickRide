PORT = 3000
RELOAD_INTERVAL = 10
SERVER_URL = http://localhost:3000 
CLIENT_URL = http://localhost:5173 # Change to deployed frontend url if in production
ENVIRONMENT = development # Change to "production" for deployment
MONGODB_PROD_URL = <your-mongodb-atlas-connection-string>
MONGODB_DEV_URL = mongodb://127.0.0.1:27017/quickRide
JWT_SECRET = <your-json-secret-string>
GOOGLE_MAPS_API = <your-google-maps-api-key>
MAIL_USER = <your-gmail-id>
MAIL_PASS = <your-app-specific-gmail-password>
SUPERAPP_API_KEY = <shared-secret-for-superapp-integration>

# Outbound: called by this server to push ride status updates (driver
# accepted/arriving/started/completed/cancelled) back to the Super App.
# Auth reuses SUPERAPP_API_KEY above (sent as X-Api-Key) — the same Outbound
# API Key issued when this mini app registered with the Super App. No
# separate webhook secret is needed.
SUPERAPP_WEBHOOK_URL = https://xspacesuperapp.dpdns.org/api/v1/webhooks/ride-status
# Service code this mini app was registered under on the Super App side —
# must match exactly, or the Super App will reject/misroute the webhook.
SUPERAPP_SERVICE_CODE = <service-code-registered-with-superapp-eg-RIDE_001>

# "Đặt xe theo giờ" (schedule a future pickup time) — bounds on how far out
# a rider can pick, both optional, shown with their built-in defaults. The
# ride is still dispatched to nearby captains immediately on creation either
# way; scheduledFor is only carried along for display.
# SCHEDULE_MIN_LEAD_MINUTES = 30 # can't schedule less than this far out
# SCHEDULE_MAX_ADVANCE_DAYS = 7  # can't schedule more than this far out
